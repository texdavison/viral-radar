# Copy this file to .env and fill in what you have. Never commit .env.

# YouTube Data API v3 key (free): Google Cloud Console > APIs & Services >
# enable "YouTube Data API v3" > Credentials > Create API key.
YOUTUBE_API_KEY=

# Instagram Graph API (needs admin on the @how_does_it_work1 Professional account).
# Long-lived tokens last about 60 days; refresh before they expire.
IG_ACCESS_TOKEN=
IG_USER_ID=
